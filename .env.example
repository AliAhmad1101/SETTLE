# SETTLE environment configuration
# Every value below is optional. SETTLE runs fully without any of them.
# Copy this file to .env and fill in values only if you want live services.

# Optional: an LLM API key. When empty, SETTLE uses its built in rule based
# reasoning engine, which works offline and never needs credentials.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: Razorpay test mode credentials for importing live payment records.
# Use test mode keys from the Razorpay dashboard. The demo never requires these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=